      "riskLevel": "medium",
      "inputs": ["change description", "affected files", "dependency graph", "data and external interfaces"],
      "expectedOutput": ["impact dimensions", "rollback assessment", "review-effort classification"],
      "evaluationFixtures": []
    },
    {
      "id": "escalation-protocol",
