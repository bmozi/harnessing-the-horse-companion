      "riskLevel": "high",
      "inputs": ["gate failure details", "attempt history", "override request"],
      "expectedOutput": ["failure classification", "decision", "owner and next action"],
      "evaluationFixtures": []
    },
    {
      "id": "subagent-challenge-clauses",
