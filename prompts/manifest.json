{
  "schemaVersion": 1,
  "libraryVersion": "2.0.0",
  "modelPolicy": "Use a frontier-capable reasoning or coding model and evaluate adaptations against repository-specific evidence.",
  "prompts": [
    {
      "id": "structured-generation",
      "file": "structured-prompt.md",
      "purpose": "Generate a bounded change from explicit requirements, constraints, MUST-NOT rules, and review criteria.",
      "riskLevel": "medium",
      "inputs": ["task", "functional requirements", "constraints", "MUST-NOT list", "output format", "review criteria"],
      "expectedOutput": ["scope restatement", "implementation", "verification evidence", "assumptions and limitations"],
      "evaluationFixtures": ["../prompt-evals/structured-generation.json"]
    },
    {
      "id": "quality-gate-configuration-review",
      "file": "quality-gate-config-review.md",
      "purpose": "Audit whether automated checks are classified and enforced according to consequence.",
      "riskLevel": "medium",
      "inputs": ["CI configuration", "branch protection policy", "project gate definitions"],
      "expectedOutput": ["classification gaps", "enforcement gaps", "specific remediation"],
      "evaluationFixtures": []
    },
    {
      "id": "disprove-only-review",
      "file": "disprove-only-review.md",
      "purpose": "Challenge an implementation claim against gates, acceptance criteria, and failure dimensions.",
      "riskLevel": "high",
      "inputs": ["SPEC", "MUST-NOT list", "implementation", "test and gate evidence"],
      "expectedOutput": ["gate status", "criterion traceability", "findings with evidence", "disposition"],
      "evaluationFixtures": ["../prompt-evals/disprove-only-review.json"]
    },
    {
      "id": "adversarial-validation",
      "file": "adversarial-validation.md",
      "purpose": "Run a fresh-context destructive review for high-risk changes.",
      "riskLevel": "high",
      "inputs": ["SPEC", "MUST-NOT list", "implementation", "approved interfaces"],
      "expectedOutput": ["critical findings", "security findings", "verification-stance audit", "limitations"],
      "evaluationFixtures": []
    },
    {
