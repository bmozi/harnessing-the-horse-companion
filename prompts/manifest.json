      "riskLevel": "low",
      "inputs": ["host prompt", "task risk"],
      "expectedOutput": ["explicit rationale", "error-path evidence", "uncertainty markers"],
      "evaluationFixtures": []
    },
    {
      "id": "verification-stance-markers",
